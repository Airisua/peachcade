# Port the web server listens on
PORT=3000
# REQUIRED in production: random string used to sign login tokens (change it!)
JWT_SECRET=change-me-to-a-long-random-string
# Initial admin account (created on first start when the database is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123


# Public origin used by canonicals, sitemaps and the RSS feed.
SITE_URL=https://peachcat.fun
# Host that must answer; the www alias 301s here. Empty = derive from the request.
CANONICAL_HOST=peachcat.fun
# Set to 0 when an upstream proxy already folds www onto the apex host.
REDIRECT_WWW=1
