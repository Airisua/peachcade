<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container pad-y">
  <div class="rewards-head center">
    <span class="chip chip-hot"><svg class="ic" style="width:14px;height:14px"><use href="/img/icons.svg?v=<%= assetV %>#i-gift"></use></svg><%= t('rewards.badge') %></span>
    <h1 style="margin:10px 0 6px"><%= t('rewards.title') %></h1>
    <p class="muted" style="max-width:640px;margin:0 auto 20px"><%= t('rewards.desc') %></p>
  </div>
  <div class="panel rewards-panel" style="padding:14px;border-radius:18px;max-width:1120px;margin:0 auto;box-shadow:var(--shadow)">
    <iframe 
      id="offerwall-frame" 
      src="https://www.cdnnd.com/wall/KDhq" 
      title="Peachcade Rewards Wall" 
      style="width:100%;height:780px;border:none;border-radius:12px;background:#101019;display:block" 
      sandbox="allow-popups allow-same-origin allow-scripts allow-forms allow-top-navigation-by-user-activation allow-popups-to-escape-sandbox" 
      referrerpolicy="no-referrer">
    </iframe>
    <div class="rewards-foot center muted small" style="margin-top:14px;display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap">
      <span>🔒 <%= t('rewards.safetyTip') %></span>
      <span>·</span>
      <a href="https://www.cdnnd.com/wall/KDhq" target="_blank" rel="noopener" class="linklike" style="color:var(--brand2)"><svg class="ic" style="width:14px;height:14px"><use href="/img/icons.svg?v=<%= assetV %>#i-external"></use></svg><%= t('rewards.newTab') %></a>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
