<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<%- include('partials/ad', { slot: 'list-top' }) %>
<main class="container">
  <% var countLabel = totalGames === 1 ? t('home.totalGamesOne') : t('home.totalGames'); %>
  <div class="list-head">
    <h1><%= heading %></h1>
    <div class="muted small"><%= fmt(totalGames) %> <%= countLabel %></div>
  </div>
  <div class="filterbar">
    <span class="muted small"><%= t('list.sort') %></span>
    <% [['popular','list.sortPopular'],['new','list.sortNew'],['likes','list.sortLikes'],['name','list.sortName']].forEach(function (s) { %>
    <a class="chip <%= sort === s[0] ? 'chip-active' : '' %>" href="<%= basePath %>sort=<%= s[0] %>"><%= t(s[1]) %></a>
    <% }); %>
  </div>
  <% if (typeof categoryTags !== 'undefined' && categoryTags && categoryTags.length) { %>
  <div class="tag-strip">
    <span class="muted small"><%= t('tags.popularInCategory', { name: heading }) %></span>
    <div class="tagcloud">
      <% categoryTags.forEach(function (item) { %>
      <a class="chip chip-sm" href="/tag/<%= encodeURIComponent(item.slug) %>"><%= item.display %> <span class="chip-n"><%= fmt(item.count) %></span></a>
      <% }); %>
      <a class="chip chip-sm chip-ghost" href="/tags"><%= t('tags.all') %></a>
    </div>
  </div>
  <% } %>
  <% if (games.length) { %>
  <div class="grid-cards"><% games.forEach(function (g, i) { %><%- include('partials/gamecard', { g: g, eager: i < 4 }) %><% }); %></div>
  <%- include('partials/pagination', { page: page, pages: pages, base: basePath + 'sort=' + sort + '&' }) %>
  <% } else { %>
  <p class="empty"><%= t('list.noResults') %></p>
  <% } %>
  <% if (typeof tagHub !== 'undefined' && tagHub) { %>
  <section class="panel tag-hub">
    <h2><%= t('tags.aboutTitle', { name: tagHub.display }) %></h2>
    <p><%= tagHub.intro %></p>
    <% if (tagHub.related && tagHub.related.length) { %>
    <h3><%= t('tags.relatedTitle') %></h3>
    <div class="tagcloud">
      <% tagHub.related.forEach(function (item) { %>
      <a class="chip chip-sm" href="/tag/<%= encodeURIComponent(item.slug) %>"><%= item.display %> <span class="chip-n"><%= fmt(item.count) %></span></a>
      <% }); %>
      <a class="chip chip-sm chip-ghost" href="/tags"><%= t('tags.all') %></a>
    </div>
    <% } %>
  </section>
  <% } %>
  <% if (typeof catContent !== 'undefined' && catContent) { %>
  <section class="panel cat-editorial">
    <h2><%= t('category.aboutTitle', { name: heading }) %></h2>
    <p><%= catContent.about %></p>
    <% if (catContent.highlights) { %>
    <h3><%= t('category.highlightsTitle') %></h3>
    <p><%= catContent.highlights %></p>
    <% } %>
    <% if (catContent.faqs && catContent.faqs.length) { %>
    <h3><%= t('category.faqTitle', { name: heading }) %></h3>
    <div class="faq-list">
      <% catContent.faqs.forEach(function (faq) { %>
      <details class="faq-item" open>
        <summary class="faq-q"><b><%= faq.q %></b></summary>
        <div class="faq-a"><p><%= faq.a %></p></div>
      </details>
      <% }); %>
    </div>
    <% } %>
  </section>
  <% } %>
</main>
<%- include('partials/footer') %>
