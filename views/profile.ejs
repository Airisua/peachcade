<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container">
  <div class="panel profile-head">
    <div class="avatar lg"><%= user.username.charAt(0).toUpperCase() %></div>
    <div>
      <h1><%= user.username %></h1>
      <div class="muted small"><%= user.email %></div>
      <div class="muted small"><%= t('profile.memberSince') %>: <%= fmtDate(user.created_at) %> · <%= t('profile.role') %>: <%= user.role === 'admin' ? t('profile.roleAdmin') : t('profile.roleUser') %></div>
    </div>
  </div>
  <section class="section">
    <div class="section-head"><h2><%= t('profile.favorites') %></h2></div>
    <% if (favorites.length) { %><div class="grid-cards"><% favorites.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div><% } else { %><p class="muted"><%= t('profile.noFavorites') %></p><% } %>
  </section>
  <section class="section">
    <div class="section-head"><h2><%= t('profile.history') %></h2></div>
    <% if (history.length) { %><div class="grid-cards"><% history.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div><% } else { %><p class="muted"><%= t('profile.noHistory') %></p><% } %>
  </section>
  <section class="section">
    <div class="section-head"><h2><%= t('profile.myComments') %></h2></div>
    <% if (comments.length) { %>
    <div class="comments">
      <% comments.forEach(function (c) { %>
      <div class="comment">
        <div class="comment-body">
          <div class="comment-head"><b><a href="/game/<%= c.game_slug %>"><%= lang === 'zh' && c.game_title_zh ? c.game_title_zh : c.game_title_en %></a></b><span class="muted small"><%= fmtDate(c.created_at) %></span></div>
          <p><%= c.content %></p>
          <form method="post" action="/comment/<%= c.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="linklike danger small" data-confirm="1"><%= t('common.delete') %></button></form>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %><p class="muted"><%= t('profile.noComments') %></p><% } %>
  </section>
  <section class="section">
    <div class="section-head"><h2><%= t('profile.changePassword') %></h2></div>
    <form method="post" action="/profile/password" class="panel form narrow">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-group">
        <label for="old_password"><%= t('profile.oldPassword') %></label>
        <div class="input-wrap password-wrap">
          <input id="old_password" class="form-input" type="password" name="old_password" required autocomplete="current-password">
          <button type="button" class="btn-toggle-pw" aria-label="Toggle password visibility" tabindex="-1">
            <svg class="ic ic-eye"><use href="/img/icons.svg#i-eye"></use></svg>
            <svg class="ic ic-eye-off" style="display:none"><use href="/img/icons.svg#i-eye-off"></use></svg>
          </button>
        </div>
      </div>
      <div class="form-group">
        <label for="new_password"><%= t('profile.newPassword') %></label>
        <div class="input-wrap password-wrap">
          <input id="new_password" class="form-input" type="password" name="new_password" required minlength="6" autocomplete="new-password">
          <button type="button" class="btn-toggle-pw" aria-label="Toggle password visibility" tabindex="-1">
            <svg class="ic ic-eye"><use href="/img/icons.svg#i-eye"></use></svg>
            <svg class="ic ic-eye-off" style="display:none"><use href="/img/icons.svg#i-eye-off"></use></svg>
          </button>
        </div>
      </div>
      <div class="form-row"><button class="btn btn-primary" type="submit"><%= t('profile.updatePassword') %></button></div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
