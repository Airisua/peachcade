<%- include('partials/head', { pageTitle: null, preloadImage: hero ? thumb(hero, 'hero') : '' }) %>
<%- include('partials/header') %>
<%- include('partials/ad', { slot: 'header' }) %>
<main class="container">
  <section class="hero <%= hero ? '' : 'hero-solo' %>">
    <div class="hero-text">
      <h1 class="hero-h1"><%= t('home.h1') %></h1>
      <p class="hero-sub"><%= t('home.h1sub') %></p>
      <% if (hero) { %>
      <span class="chip chip-hot"><%= t('home.featured') %></span>
      <h2 class="hero-game"><%= gt(hero) %></h2>
      <p><%= gd(hero) %></p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/game/<%= hero.slug %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-play"></use></svg><%= t('home.playNow') %></a>
        <a class="btn btn-ghost btn-lg" href="/random"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-dice"></use></svg><%= t('home.random') %></a>
      </div>
      <div class="muted small"><%= fmt(hero.plays) %> <%= t('game.plays') %> · <%= fmt(total) %> <%= t('home.totalGames') %></div>
      <% } else { %>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="/games"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-gamepad"></use></svg><%= t('common.allGames') %></a>
        <a class="btn btn-ghost btn-lg" href="/random"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-dice"></use></svg><%= t('home.random') %></a>
      </div>
      <% } %>
    </div>
    <% if (hero) { %>
    <a class="hero-art" href="/game/<%= hero.slug %>"><img src="<%= thumb(hero, 'hero') %>" alt="<%= gt(hero) %>" width="640" height="360" fetchpriority="high" decoding="async"></a>
    <% } %>
  </section>
  <% if (navCategories.length) { %>
  <section class="section">
    <div class="section-head"><h2><%= t('home.browseByCategory') %></h2></div>
    <div class="cat-grid">
      <% navCategories.forEach(function (c) { %>
      <a class="cat-card" href="/category/<%= c.slug %>">
        <span class="cat-visual">
          <% if (c.sample_thumb) { %>
          <img class="cat-thumb" src="<%= thumb(c.sample_thumb, 'cat') %>" alt="<%= catName(c) %>" width="54" height="42" loading="lazy" decoding="async">
          <% } else { %>
          <svg class="ic cat-icon"><use href="<%= catIcon(c) %>"></use></svg>
          <% } %>
          <svg class="ic cat-glyph"><use href="<%= catIcon(c) %>"></use></svg>
        </span>
        <span class="cat-meta">
          <b><%= catName(c) %></b>
          <small class="muted"><%= c.n %> <%= t('home.totalGames') %></small>
        </span>
      </a>
      <% }); %>
    </div>
  </section>
  <% } %>
  <% if (continueList.length) { %>
  <section class="section">
    <div class="section-head"><h2><%= t('home.continue') %></h2></div>
    <div class="grid-cards"><% continueList.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div>
  </section>
  <% } %>
  <% if (featured.length) { %>
  <section class="section">
    <div class="section-head"><h2><%= t('home.featured') %></h2><a class="see-all" href="/games"><%= t('common.viewAll') %></a></div>
    <div class="grid-cards"><% featured.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div>
  </section>
  <% } %>
  <section class="section">
    <div class="section-head"><h2><%= t('home.popular') %></h2><a class="see-all" href="/games?sort=popular"><%= t('common.viewAll') %></a></div>
    <div class="grid-cards"><% popular.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div>
  </section>
  <%- include('partials/ad', { slot: 'home-mid' }) %>
  <section class="section">
    <div class="section-head"><h2><%= t('home.new') %></h2><a class="see-all" href="/games?sort=new"><%= t('common.viewAll') %></a></div>
    <div class="grid-cards"><% newest.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div>
  </section>
  <section class="section">
    <div class="section-head"><h2><%= t('home.topRated') %></h2><a class="see-all" href="/games?sort=likes"><%= t('common.viewAll') %></a></div>
    <div class="grid-cards"><% topRated.forEach(function (g) { %><%- include('partials/gamecard', { g: g }) %><% }); %></div>
  </section>
  <section class="section">
    <div class="panel editorial-panel">
      <h2><%= t('home.aboutTitle') %></h2>
      <p><%= t('home.aboutP1') %></p>
      <p><%= t('home.aboutP2') %></p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
