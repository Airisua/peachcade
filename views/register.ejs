<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container auth-wrap">
  <div class="panel auth-card">
    <div class="auth-header">
      <h2><%= t('auth.registerTitle') %></h2>
      <p class="muted small"><%= t('auth.registerSub') %></p>
    </div>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <form method="post" action="/register" class="form auth-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-group">
        <label for="reg-username"><%= t('auth.username') %></label>
        <div class="input-wrap">
          <input id="reg-username" class="form-input" type="text" name="username" value="<%= username %>" placeholder="<%= t('auth.usernamePlaceholder') %>" required autofocus autocomplete="username">
        </div>
      </div>
      <div class="form-group">
        <label for="reg-email"><%= t('auth.email') %></label>
        <div class="input-wrap">
          <input id="reg-email" class="form-input" type="email" name="email" value="<%= email %>" placeholder="<%= t('auth.emailPlaceholder') %>" required autocomplete="email">
        </div>
      </div>
      <div class="form-group">
        <label for="reg-password"><%= t('auth.password') %></label>
        <div class="input-wrap password-wrap">
          <input id="reg-password" class="form-input" type="password" name="password" placeholder="<%= t('auth.passwordReq') %>" required minlength="6" autocomplete="new-password">
          <button type="button" class="btn-toggle-pw" aria-label="Toggle password visibility" tabindex="-1">
            <svg class="ic ic-eye"><use href="/img/icons.svg#i-eye"></use></svg>
            <svg class="ic ic-eye-off" style="display:none"><use href="/img/icons.svg#i-eye-off"></use></svg>
          </button>
        </div>
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit"><%= t('auth.registerBtn') %></button>
    </form>
    <div class="auth-footer">
      <p class="muted"><%= t('auth.haveAccount') %> <a href="/login" class="auth-link"><%= t('nav.login') %></a></p>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
