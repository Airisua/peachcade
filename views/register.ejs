<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container auth-wrap">
  <div class="panel auth-card">
    <h2><%= t('auth.registerTitle') %></h2>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label><%= t('auth.username') %><input name="username" value="<%= username %>" required autofocus></label>
      <label><%= t('auth.email') %><input type="email" name="email" value="<%= email %>" required></label>
      <label><%= t('auth.password') %><input type="password" name="password" required minlength="6"></label>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth.registerBtn') %></button>
    </form>
    <p class="muted"><%= t('auth.haveAccount') %> <a href="/login"><%= t('nav.login') %></a></p>
  </div>
</main>
<%- include('partials/footer') %>
