<%- include('../partials/admin_top', { pageTitle: pageTitle }) %>
<div class="toolbar">
  <form class="searchbox small" action="/wyj/games" method="get">
    <svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-search"></use></svg>
    <input name="q" value="<%= q %>" placeholder="<%= t('nav.searchPlaceholder') %>">
    <select name="category" class="select-sm" data-autosubmit title="<%= t('list.category') %>">
      <option value=""><%= t('common.allCategories') %></option>
      <% categories.forEach(function (c) { %>
      <option value="<%= c.slug %>" <%= (typeof category !== 'undefined' && category === c.slug) ? 'selected' : '' %>><%= catName(c) %></option>
      <% }); %>
    </select>
    <select name="status" class="select-sm" data-autosubmit title="<%= t('admin.filterStatus') %>">
      <option value="all" <%= (typeof status === 'undefined' || status === 'all') ? 'selected' : '' %>><%= t('admin.statusAll') %></option>
      <option value="published" <%= (typeof status !== 'undefined' && status === 'published') ? 'selected' : '' %>><%= t('admin.statusPublished') %></option>
      <option value="unpublished" <%= (typeof status !== 'undefined' && status === 'unpublished') ? 'selected' : '' %>><%= t('admin.statusUnpublished') %></option>
      <option value="featured" <%= (typeof status !== 'undefined' && status === 'featured') ? 'selected' : '' %>><%= t('admin.statusFeatured') %></option>
    </select>
    <select name="sort" class="select-sm" data-autosubmit title="<%= t('admin.sortBy') %>">
      <option value="new" <%= sort === 'new' ? 'selected' : '' %>><%= t('admin.sortNew') %></option>
      <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>><%= t('admin.sortOldest') %></option>
      <option value="heat" <%= sort === 'heat' ? 'selected' : '' %>><%= t('admin.sortHeat') %></option>
      <option value="least" <%= sort === 'least' ? 'selected' : '' %>><%= t('admin.sortLeast') %></option>
      <option value="likes" <%= sort === 'likes' ? 'selected' : '' %>><%= t('admin.sortLikes') %></option>
      <option value="favorites" <%= sort === 'favorites' ? 'selected' : '' %>><%= t('admin.sortFavorites') %></option>
      <option value="comments" <%= sort === 'comments' ? 'selected' : '' %>><%= t('admin.sortComments') %></option>
      <option value="name" <%= sort === 'name' ? 'selected' : '' %>><%= t('admin.sortName') %></option>
    </select>
  </form>
  <a class="btn btn-primary" href="/wyj/games/new"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-plus"></use></svg><%= t('admin.newGame') %></a>
</div>
<div class="toolbar bulkbar">
  <span class="muted small"><%= t('admin.bulkHint') %><b id="bulk-count">0</b></span>
  <div class="bulk-actions">
    <button class="btn btn-sm btn-primary" type="submit" form="bulk-form" name="action" value="publish"><%= t('admin.bulkPublish') %></button>
    <button class="btn btn-sm btn-ghost" type="submit" form="bulk-form" name="action" value="unpublish"><%= t('admin.bulkUnpublish') %></button>
    <button class="btn btn-sm btn-ghost" type="submit" form="bulk-form" name="action" value="feature"><%= t('admin.bulkFeature') %></button>
    <button class="btn btn-sm btn-ghost" type="submit" form="bulk-form" name="action" value="unfeature"><%= t('admin.bulkUnfeature') %></button>
    <button class="btn btn-sm btn-danger" type="submit" form="bulk-form" name="action" value="delete" data-confirm="1" formnovalidate><%= t('admin.bulkDelete') %></button>
  </div>
</div>
<form method="post" action="/wyj/games/bulk" id="bulk-form">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
</form>
<div class="tbl-wrap">
<table class="tbl">
  <tr>
    <th><input type="checkbox" data-check-all form="bulk-form" title="<%= t('admin.bulkSelectAll') %>"></th>
    <th><%= t('admin.tblId') %></th>
    <th></th>
    <th><%= t('admin.tblTitle') %></th>
    <th><%= t('admin.tblSlug') %></th>
    <th><%= t('admin.tblCategory') %></th>
    <th><%= t('admin.tblSource') %></th>
    <th><a href="<%= base %>sort=heat" title="<%= t('admin.sortHeat') %>"><%= t('admin.tblPlays') %><%= sort === 'heat' ? ' ▾' : (sort === 'least' ? ' ▴' : '') %></a></th>
    <th><a href="<%= base %>sort=likes" title="<%= t('admin.sortLikes') %>"><%= t('admin.tblLikes') %><%= sort === 'likes' ? ' ▾' : '' %></a></th>
    <th><a href="<%= base %>sort=favorites" title="<%= t('admin.sortFavorites') %>"><%= t('admin.tblFavs') %><%= sort === 'favorites' ? ' ▾' : '' %></a></th>
    <th><a href="<%= base %>sort=comments" title="<%= t('admin.sortComments') %>"><%= t('admin.tblComments') %><%= sort === 'comments' ? ' ▾' : '' %></a></th>
    <th>F</th><th>P</th>
    <th><%= t('admin.tblActions') %></th>
  </tr>
  <% games.forEach(function (g) { %>
  <tr>
    <td><input type="checkbox" name="sel" value="<%= g.id %>" form="bulk-form"></td>
    <td><%= g.id %></td>
    <td><img class="tbl-thumb" src="<%= thumb(g, 'thumb') %>" alt="" loading="lazy"></td>
    <td><%= g.title_en %><% if (g.title_zh) { %><br><small class="muted"><%= g.title_zh %></small><% } %></td>
    <td><code><%= g.slug %></code></td>
    <td><%= g.category %></td>
    <td><%= g.source || '-' %></td>
    <td><%= fmt(g.plays) %></td>
    <td><%= fmt(g.likes) %></td>
    <td><%= fmt(g.favs || 0) %></td>
    <td><%= fmt(g.cmts || 0) %></td>
    <td><%= g.featured ? '★' : '' %></td>
    <td><%= g.published ? '✓' : '—' %></td>
    <td class="actions">
      <a class="btn btn-sm btn-ghost" href="/wyj/games/<%= g.id %>/edit"><%= t('admin.edit') %></a>
      <form method="post" action="/wyj/games/<%= g.id %>/toggle" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost" type="submit"><%= t('admin.togglePublish') %></button></form>
      <form method="post" action="/wyj/games/<%= g.id %>/feature" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost" type="submit"><%= t('admin.toggleFeature') %></button></form>
      <form method="post" action="/wyj/games/<%= g.id %>/delete" class="inline" data-confirm-form="1"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger" type="submit"><%= t('common.delete') %></button></form>
    </td>
  </tr>
  <% }); %>
</table>
</div>
<% if (typeof note !== 'undefined' && note) { %><div class="notice ok"><%= note %></div><% } %>
<%- include('../partials/pagination', { page: page, pages: pages, base: base }) %>
<%- include('../partials/admin_bottom') %>
