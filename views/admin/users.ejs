<%- include('../partials/admin_top', { pageTitle: pageTitle }) %>
<table class="tbl">
  <tr><th><%= t('admin.tblId') %></th><th><%= t('admin.tblUser') %></th><th>Email</th><th><%= t('admin.tblRole') %></th><th><%= t('admin.tblComments') %></th><th><%= t('admin.tblCreated') %></th><th><%= t('admin.tblActions') %></th></tr>
  <% users.forEach(function (u) { %>
  <tr>
    <td><%= u.id %></td>
    <td><%= u.username %> <% if (u.banned) { %><span class="badge danger"><%= t('admin.bannedBadge') %></span><% } %></td>
    <td class="muted small"><%= u.email %></td>
    <td><span class="badge <%= u.role === 'admin' ? 'ok' : '' %>"><%= u.role %></span></td>
    <td><%= u.comments %></td>
    <td class="muted small"><%= fmtDate(u.created_at) %></td>
    <td class="actions">
      <form method="post" action="/wyj/users/<%= u.id %>/role" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost" type="submit"><%= u.role === 'admin' ? t('admin.makeUser') : t('admin.makeAdmin') %></button></form>
      <form method="post" action="/wyj/users/<%= u.id %>/ban" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-ghost" type="submit"><%= u.banned ? t('admin.unban') : t('admin.ban') %></button></form>
      <form method="post" action="/wyj/users/<%= u.id %>/delete" class="inline" data-confirm-form="1"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger" type="submit"><%= t('common.delete') %></button></form>
    </td>
  </tr>
  <% }); %>
</table>
<%- include('../partials/admin_bottom') %>
