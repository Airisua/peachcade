<%- include('../partials/admin_top', { pageTitle: pageTitle }) %>
<form method="post" action="/wyj/settings" class="panel form wide">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="form-grid">
    <label><%= t('admin.settings_site_name') %><input name="site_name" value="<%= values.site_name %>"></label>
    <label><%= t('admin.settings_tagline_en') %><input name="tagline_en" value="<%= values.tagline_en %>"></label>
    <label><%= t('admin.settings_tagline_zh') %><input name="tagline_zh" value="<%= values.tagline_zh %>"></label>
    <label><%= t('admin.settings_tagline_ja') %><input name="tagline_ja" value="<%= values.tagline_ja %>"></label>
    <label><%= t('admin.settings_footer_text_en') %><input name="footer_text_en" value="<%= values.footer_text_en %>"></label>
    <label><%= t('admin.settings_footer_text_zh') %><input name="footer_text_zh" value="<%= values.footer_text_zh %>"></label>
    <label><%= t('admin.settings_footer_text_ja') %><input name="footer_text_ja" value="<%= values.footer_text_ja %>"></label>
  </div>
  <div class="form-row">
    <label class="check"><input type="checkbox" name="ads_enabled" <%= values.ads_enabled === '1' ? 'checked' : '' %>><%= t('admin.settings_ads_enabled') %></label>
    <label class="check"><input type="checkbox" name="registration_open" <%= values.registration_open === '1' ? 'checked' : '' %>><%= t('admin.settings_registration_open') %></label>
    <label class="check"><input type="checkbox" name="ezoic_enabled" <%= values.ezoic_enabled === '1' ? 'checked' : '' %>><%= t('admin.settings_ezoic_enabled') %></label>
    <label class="check"><input type="checkbox" name="ezoic_adstxt_redirect" <%= values.ezoic_adstxt_redirect === '1' ? 'checked' : '' %>><%= t('admin.settings_ezoic_adstxt_redirect') %></label>
  </div>
  <div class="form-row"><button class="btn btn-primary" type="submit"><%= t('common.save') %></button></div>
</form>
<div class="panel">
  <h2><%= t('admin.settings_ads_txt') %></h2>
  <p class="muted small"><%= t('admin.settings_ads_txt_hint') %></p>
  <form method="post" action="/wyj/settings" class="form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="site_name" value="<%= values.site_name %>">
    <input type="hidden" name="tagline_en" value="<%= values.tagline_en %>">
    <input type="hidden" name="tagline_zh" value="<%= values.tagline_zh %>">
    <input type="hidden" name="tagline_ja" value="<%= values.tagline_ja %>">
    <input type="hidden" name="footer_text_en" value="<%= values.footer_text_en %>">
    <input type="hidden" name="footer_text_zh" value="<%= values.footer_text_zh %>">
    <input type="hidden" name="footer_text_ja" value="<%= values.footer_text_ja %>">
    <% if (values.ads_enabled === '1') { %><input type="hidden" name="ads_enabled" value="on"><% } %>
    <% if (values.registration_open === '1') { %><input type="hidden" name="registration_open" value="on"><% } %>
    <% if (values.ezoic_enabled === '1') { %><input type="hidden" name="ezoic_enabled" value="on"><% } %>
    <% if (values.ezoic_adstxt_redirect === '1') { %><input type="hidden" name="ezoic_adstxt_redirect" value="on"><% } %>
    <div class="form-group">
      <textarea id="ads_txt" name="ads_txt" rows="7" spellcheck="false" style="font-family:ui-monospace,Consolas,monospace;font-size:12.5px"><%= values.ads_txt %></textarea>
    </div>
    <div class="form-row">
      <button class="btn btn-primary" type="submit"><%= t('common.save') %></button>
      <a class="btn btn-ghost" href="/ads.txt" target="_blank" rel="noopener">/ads.txt</a>
    </div>
  </form>
</div>
<%- include('../partials/admin_bottom') %>
