<%- include('partials/head', { pageTitle: (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : gt(game), ogTitle: (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : gt(game), ogDesc: (typeof metaDesc !== 'undefined' && metaDesc) ? metaDesc : gd(game), ogImage: game.thumb }) %>
<%- include('partials/header') %>
<%- include('partials/ad', { slot: 'header' }) %>
<main class="container">
  <nav class="breadcrumb muted small">
    <a href="/"><%= t('nav.home') %></a><span>/</span>
    <a href="/category/<%= game.category %>"><%= catName({ name_en: game.cat_en, name_zh: game.cat_zh, name_ja: game.cat_ja }) || game.category %></a><span>/</span>
    <span><%= gt(game) %></span>
  </nav>
  <% if (!game.published) { %><div class="notice warn"><%= t('game.unpublishedBadge') %></div><% } %>
  <div class="game-head">
    <h1><%= gt(game) %></h1>
    <div class="game-stats muted small">
      <span class="rating-pill" title="<%= rating.score %> / 5.0 · <%= rating.percent %>%"><svg class="ic ic-gold"><use href="/img/icons.svg?v=<%= assetV %>#i-star"></use></svg><b><%= rating.score %></b> <small>(<%= rating.percent %>%)</small></span>
      <span><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-play"></use></svg><%= fmt(game.plays) %> <%= t('game.plays') %></span>
      <span><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-heart"></use></svg><%= fmt(game.likes) %></span>
    </div>
  </div>
  <div class="player-wrap">
    <div class="player-box" id="player-box">
      <div class="player-loader" id="player-loader">
        <div class="player-spinner"></div>
        <span class="player-loader-text"><%= t('game.loading') %></span>
        <a class="player-loader-fallback small muted" href="<%= game.embed_url %>" target="_blank" rel="noopener"><%= t('game.trouble') %> <%= t('game.newTab') %></a>
      </div>
      <iframe id="game-frame" src="<%= game.embed_url %>" title="<%= gt(game) %>" allowfullscreen sandbox="allow-scripts allow-same-origin allow-pointer-lock allow-forms allow-popups allow-orientation-lock"></iframe>
    </div>
    <div class="player-bar">
      <button class="btn btn-icon <%= liked ? 'on' : '' %>" id="like-btn" data-like="<%= game.id %>" title="<%= t('game.like') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-heart"></use></svg><span class="n"><%= fmt(game.likes) %></span></button>
      <button class="btn btn-icon <%= favorited ? 'on' : '' %>" id="fav-btn" data-fav="<%= game.id %>" title="<%= t('game.favorite') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-star"></use></svg></button>
      <button class="btn btn-icon" id="reload-btn" data-reload="#game-frame" title="<%= t('game.reload') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-reload"></use></svg></button>
      <button class="btn btn-icon" id="theater-btn" data-theater title="<%= t('game.theater') %> (T)"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-theater"></use></svg></button>
      <button class="btn btn-icon" data-fs="#player-box" title="<%= t('game.fullscreen') %> (F)"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-maximize"></use></svg></button>
      <a class="btn btn-icon" href="<%= game.embed_url %>" target="_blank" rel="noopener" title="<%= t('game.newTab') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-external"></use></svg></a>
      <button class="btn btn-icon" data-share title="<%= t('game.share') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-share"></use></svg></button>
    </div>
  </div>
  <%- include('partials/ad', { slot: 'game-under' }) %>
  <div class="game-cols">
    <div class="game-main">
      <% if (gh(game)) { %>
      <section class="panel">
        <h2><%= t('game.howto') %></h2>
        <p><%= gh(game) %></p>
      </section>
      <% } %>
      <section class="panel">
        <h2><%= t('game.about') %></h2>
        <p><%= gd(game) || t('game.noDesc', { title: gt(game), category: catLabel }) %></p>
        <% if (game.tags) { %>
        <div class="tags"><% game.tags.split(',').forEach(function (tag) { var tt = tag.trim(); if (tt && !['gamemonetize', 'ext', 'rss', 'json', 'mapi-games'].includes(tt.toLowerCase())) { %><a class="chip" href="/tag/<%= encodeURIComponent(tt.toLowerCase().replace(/\s+/g, '-')) %>"><%= tt %></a><% } }); %></div>
        <% } %>
      </section>
      <section class="panel game-specs">
        <h2><%= t('game.specsTitle') %></h2>
        <div class="specs-grid">
          <div class="specs-row"><span class="specs-key"><%= t('game.specPlatform') %></span><span class="specs-val">Web Browser (Desktop, Mobile, Tablet)</span></div>
          <div class="specs-row"><span class="specs-key"><%= t('game.specTech') %></span><span class="specs-val">HTML5 / WebGL</span></div>
          <div class="specs-row"><span class="specs-key"><%= t('game.specGenre') %></span><span class="specs-val"><a href="/category/<%= game.category %>"><%= catLabel %></a></span></div>
          <div class="specs-row"><span class="specs-key"><%= t('game.specControls') %></span><span class="specs-val"><%= t('game.specControlsVal') %></span></div>
          <div class="specs-row"><span class="specs-key"><%= t('game.specPrice') %></span><span class="specs-val"><%= t('game.specPriceVal') %></span></div>
          <% if (game.created_at) { %><div class="specs-row"><span class="specs-key"><%= t('game.specReleased') %></span><span class="specs-val"><%= String(game.created_at).slice(0, 10) %></span></div><% } %>
          <div class="specs-row"><span class="specs-key"><%= t('game.specPlayed') %></span><span class="specs-val"><%= fmt(game.plays) %> <%= t('game.plays') %></span></div>
          <div class="specs-row"><span class="specs-key"><%= t('game.specRating') %></span><span class="specs-val">⭐ <%= rating.score %> / 5.0 (<%= fmt(rating.votes) %> <%= t('game.votes') %>)</span></div>
        </div>
      </section>
      <% if (typeof gameFaqs !== 'undefined' && gameFaqs && gameFaqs.length) { %>
      <section class="panel game-faq">
        <h2><%= t('game.faqTitle') %></h2>
        <div class="faq-list">
          <% gameFaqs.forEach(function (faq) { %>
          <details class="faq-item" open>
            <summary class="faq-q"><b><%= faq.q %></b></summary>
            <div class="faq-a"><p><%= faq.a %></p></div>
          </details>
          <% }); %>
        </div>
      </section>
      <% } %>
      <section class="panel" id="comments">
        <h2><%= t('game.comments') %></h2>
        <% if (user) { %>
        <form method="post" action="/game/<%= game.id %>/comment" class="comment-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <textarea name="content" rows="3" maxlength="1000" placeholder="<%= t('game.commentPlaceholder') %>" required></textarea>
          <div class="form-row"><button class="btn btn-primary" type="submit"><%= t('game.postComment') %></button></div>
        </form>
        <% } else { %>
        <p class="muted"><a href="/login?next=<%= encodeURIComponent('/game/' + game.slug) %>"><%= t('game.loginToComment') %></a></p>
        <% } %>
        <% if (!comments.length) { %><p class="muted"><%= t('game.noComments') %></p><% } %>
        <div class="comments">
          <% comments.forEach(function (c) { %>
          <div class="comment">
            <div class="avatar sm"><%= c.username.charAt(0).toUpperCase() %></div>
            <div class="comment-body">
              <div class="comment-head"><b><%= c.username %></b><span class="muted small"><%= fmtDate(c.created_at) %></span></div>
              <p><%= c.content %></p>
              <% if (user && (user.id === c.user_id || user.role === 'admin')) { %>
              <form method="post" action="/comment/<%= c.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button type="submit" class="linklike danger small" data-confirm="1"><%= t('game.deleteComment') %></button></form>
              <% } %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>
    </div>
    <aside class="game-side">
      <section class="panel">
        <h2><%= t('game.related') %></h2>
        <div class="mini-list">
          <% related.forEach(function (g) { %>
          <a class="mini-card" href="/game/<%= g.slug %>">
            <img src="<%= thumb(g, 'card') %>" alt="<%= gt(g) %>" width="84" height="47" loading="lazy" decoding="async">
            <span class="mini-meta"><b><%= gt(g) %></b><small class="muted"><%= fmt(g.plays) %> <%= t('game.plays') %></small></span>
          </a>
          <% }); %>
        </div>
      </section>
      <% if (typeof similar !== 'undefined' && similar && similar.length) { %>
      <section class="panel">
        <h2><%= t('game.similar') %></h2>
        <div class="mini-list">
          <% similar.forEach(function (g) { %>
          <a class="mini-card" href="/game/<%= g.slug %>">
            <img src="<%= thumb(g, 'card') %>" alt="<%= gt(g) %>" width="84" height="47" loading="lazy" decoding="async">
            <span class="mini-meta"><b><%= gt(g) %></b><small class="muted"><%= catName({ name_en: g.cat_en, name_zh: g.cat_zh, name_ja: g.cat_ja }) || g.category %></small></span>
          </a>
          <% }); %>
        </div>
      </section>
      <% } %>
      <%- include('partials/ad', { slot: 'sidebar' }) %>
    </aside>
  </div>
</main>
<%- include('partials/footer') %>
