<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (typeof adminCss === 'undefined' || !adminCss) { %>
<% if (typeof ezoicEnabled !== 'undefined' ? ezoicEnabled : true) { %>
<!-- Ezoic Privacy Scripts (Consent Management) -->
<script data-cfasync="false" src="https://cmp.gatekeeperconsent.com/min.js"></script>
<script data-cfasync="false" src="https://the.gatekeeperconsent.com/cmp.min.js"></script>
<!-- Ezoic Header Script -->
<script async src="//www.ezojs.com/ezoic/sa.min.js"></script>
<script>
    window.ezstandalone = window.ezstandalone || {};
    ezstandalone.cmd = ezstandalone.cmd || [];
</script>
<script src="//ezoicanalytics.com/analytics.js"></script>
<% } %>
<% } %>
<title><%= (typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle + ' · ' + site.name : site.name + ' · ' + site.tagline %></title>
<meta name="description" content="<%= (typeof metaDesc !== 'undefined' && metaDesc) ? metaDesc : ((typeof ogDesc !== 'undefined' && ogDesc) ? ogDesc : site.tagline) %>">
<link rel="icon" href="/favicon.svg">
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#0e0e16">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="<%= site.name %>">
<meta name="881a8f0468df8b90a945c1d8ffff883b0dd31fc6" content="881a8f0468df8b90a945c1d8ffff883b0dd31fc6">
<link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
<% if (typeof adminCss !== 'undefined' && adminCss) { %><link rel="stylesheet" href="/css/admin.css?v=<%= assetV %>"><% } %>
<meta name="robots" content="<%= (typeof noindex !== 'undefined' && noindex) ? 'noindex' : 'index' %>">
<% var _ogTitle = (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : ((typeof pageTitle !== 'undefined' && pageTitle) ? pageTitle : site.name); %>
<% var _ogImg = (typeof ogImage !== 'undefined' && ogImage) ? (String(ogImage).indexOf('http') === 0 ? ogImage : siteUrl + ogImage) : ''; %>
<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= _ogTitle %>">
<meta property="og:description" content="<%= (typeof ogDesc !== 'undefined' && ogDesc) ? ogDesc : site.tagline %>">
<meta property="og:url" content="<%= siteUrl + path %>">
<% if (_ogImg) { %><meta property="og:image" content="<%= _ogImg %>"><% } %>
<meta name="twitter:card" content="<%= _ogImg ? 'summary_large_image' : 'summary' %>">
<link rel="canonical" href="<%= siteUrl + path %>">
<link rel="alternate" hreflang="en" href="<%= siteUrl + path %>">
<link rel="alternate" hreflang="zh" href="<%= siteUrl + path %>?lang=zh">
<link rel="alternate" hreflang="ja" href="<%= siteUrl + path %>?lang=ja">
<link rel="alternate" hreflang="x-default" href="<%= siteUrl + path %>">
<% var _ld = (typeof schema !== 'undefined' && schema) ? (Array.isArray(schema) ? schema : [schema]) : []; %>
<% _ld.forEach(function (block) { %><script type="application/ld+json"><%- JSON.stringify(block).replace(/</g, '\\u003c') %></script>
<% }); %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<script>window.CSRF = <%- JSON.stringify(csrf) %>; window.I18N = <%- JSON.stringify({ copied: t('js.copied'), likeLogin: t('js.likeLogin'), confirmDelete: t('common.confirmDelete'), bulkNone: t('js.bulkNone') }) %>;</script>
