<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="logo"><svg class="ic ic-logo"><use href="/img/icons.svg?v=<%= assetV %>#i-gamepad"></use></svg><span><%= site.name %></span></div>
      <p class="muted"><%= site.tagline %></p>
      <% if (site.footerText) { %><p class="muted small"><%= site.footerText %></p><% } %>
    </div>
    <div>
      <h4><%= t('footer.links') %></h4>
      <a href="/"><%= t('nav.home') %></a>
      <a href="/games"><%= t('common.allGames') %></a>
      <a href="/random"><%= t('nav.random') %></a>
      <a href="/about"><%= t('footer.about') %></a>
    </div>
    <div>
      <h4><%= t('footer.categories') %></h4>
      <% navCategories.forEach(function (c) { %><a href="/category/<%= c.slug %>"><%= catName(c) %></a><% }); %>
    </div>
    <div>
      <h4><%= t('nav.language') %></h4>
      <% supportedLangs.forEach(function (l) { %>
      <a href="/lang/<%= l.code %>?next=<%= encodeURIComponent(path) %>"><%= l.label %></a>
      <% }); %>
    </div>
  </div>
  <%- include('ad', { slot: 'footer' }) %>
  <% if (typeof popularTags !== 'undefined' && popularTags && popularTags.length) { %>
  <div class="container footer-tags">
    <span class="footer-tags-label muted small"><%= t('nav.popularTags') %>:</span>
    <div class="footer-tags-list">
      <% popularTags.forEach(function (pt) { %>
      <a class="chip chip-sm" href="/tag/<%= pt.slug %>"><%= pt.tag %></a>
      <% }); %>
    </div>
  </div>
  <% } %>
  <div class="container footer-bottom">
    <span><%= t('footer.legal', { year: year, site: site.name }) %> · <a href="mailto:wyjv58787@gmail.com" class="muted"><%= t('footer.contact') %>: wyjv58787@gmail.com</a></span>
    <span class="muted"><%= t('footer.builtWith') %></span>
  </div>
</footer>
<button id="back-to-top" class="back-to-top" aria-label="<%= t('common.backToTop') %>" title="<%= t('common.backToTop') %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-arrow-up"></use></svg></button>
<nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
  <a href="/" class="mobile-nav-item <%= path === '/' ? 'active' : '' %>">
    <svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-home"></use></svg>
    <span><%= t('nav.home') %></span>
  </a>
  <a href="/games" class="mobile-nav-item <%= path.indexOf('/games') === 0 || path.indexOf('/category') === 0 ? 'active' : '' %>">
    <svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-gamepad"></use></svg>
    <span><%= t('nav.games') %></span>
  </a>
  <a href="/random" class="mobile-nav-item">
    <svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-dice"></use></svg>
    <span><%= t('nav.random') %></span>
  </a>
  <a href="<%= user ? '/profile' : '/login' %>" class="mobile-nav-item <%= path === '/profile' || path === '/login' ? 'active' : '' %>">
    <svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-user"></use></svg>
    <span><%= user ? t('nav.profile') : t('nav.login') %></span>
  </a>
</nav>
<script src="/js/main.js?v=<%= assetV %>" defer></script>
</body>
</html>
