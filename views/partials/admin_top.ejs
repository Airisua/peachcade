<%- include('../partials/head', { pageTitle: pageTitle, adminCss: true, noindex: true, bodyClass: 'admin' }) %>
<div class="admin-shell">
  <aside class="admin-side">
    <div class="admin-brand"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-shield"></use></svg><span><%= site.name %></span><em class="muted"><%= t('admin.brand') %></em></div>
    <nav class="admin-nav">
      <a href="/wyj" class="<%= path === '/wyj' ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-dashboard"></use></svg><%= t('admin.dashboard') %></a>
      <a href="/wyj/online" class="<%= path.indexOf('/wyj/online') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-users"></use></svg><%= t('admin.online') %></a>
      <a href="/wyj/games" class="<%= path.indexOf('/wyj/games') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-gamepad"></use></svg><%= t('admin.games') %></a>
      <a href="/wyj/import" class="<%= path.indexOf('/wyj/import') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-download"></use></svg><%= t('admin.import') %></a>
      <a href="/wyj/comments" class="<%= path.indexOf('/wyj/comments') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-message"></use></svg><%= t('admin.comments') %></a>
      <a href="/wyj/users" class="<%= path.indexOf('/wyj/users') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-users"></use></svg><%= t('admin.users') %></a>
      <a href="/wyj/ads" class="<%= path.indexOf('/wyj/ads') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-megaphone"></use></svg><%= t('admin.ads') %></a>
      <a href="/wyj/settings" class="<%= path.indexOf('/wyj/settings') === 0 ? 'active' : '' %>"><svg class="ic"><use href="/img/icons.svg?v=<%= assetV %>#i-settings"></use></svg><%= t('admin.settings') %></a>
    </nav>
    <div class="admin-side-foot">
      <a href="/" target="_blank"><%= t('admin.backToSite') %></a>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike" type="submit"><%= t('nav.logout') %></button></form>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-topbar"><h1><%= pageTitle %></h1><span class="muted small"><%= user.username %></span></div>
    <% if (okMsg) { %><div class="notice ok"><%= okMsg %></div><% } %>
    <% if (errMsg) { %><div class="notice error"><%= errMsg %></div><% } %>
