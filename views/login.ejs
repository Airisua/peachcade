<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container auth-wrap">
  <div class="panel auth-card">
    <div class="auth-header">
      <h2><%= t('auth.loginTitle') %></h2>
      <p class="muted small"><%= t('auth.loginSub') %></p>
    </div>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <form method="post" action="/login" class="form auth-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next || '' %>">
      <div class="form-group">
        <label for="login-username"><%= t('auth.username') %></label>
        <div class="input-wrap">
          <input id="login-username" class="form-input" type="text" name="username" value="<%= username %>" placeholder="<%= t('auth.usernamePlaceholder') %>" required autofocus autocomplete="username">
        </div>
      </div>
      <div class="form-group">
        <label for="login-password"><%= t('auth.password') %></label>
        <div class="input-wrap password-wrap">
          <input id="login-password" class="form-input" type="password" name="password" placeholder="<%= t('auth.passwordPlaceholder') %>" required autocomplete="current-password">
          <button type="button" class="btn-toggle-pw" aria-label="Toggle password visibility" tabindex="-1">
            <svg class="ic ic-eye"><use href="/img/icons.svg?v=<%= assetV %>#i-eye"></use></svg>
            <svg class="ic ic-eye-off" style="display:none"><use href="/img/icons.svg?v=<%= assetV %>#i-eye-off"></use></svg>
          </button>
        </div>
      </div>
      <button class="btn btn-primary btn-block btn-lg" type="submit"><%= t('auth.loginBtn') %></button>
    </form>
    <div class="auth-footer">
      <p class="muted"><%= t('auth.noAccount') %> <a href="/register" class="auth-link"><%= t('nav.register') %></a></p>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
