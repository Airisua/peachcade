<%- include('partials/head', { pageTitle: pageTitle }) %>
<%- include('partials/header') %>
<main class="container auth-wrap">
  <div class="panel auth-card">
    <h2><%= t('auth.loginTitle') %></h2>
    <% if (error) { %><div class="notice error"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next || '' %>">
      <label><%= t('auth.username') %><input name="username" value="<%= username %>" required autofocus></label>
      <label><%= t('auth.password') %><input type="password" name="password" required></label>
      <button class="btn btn-primary btn-block" type="submit"><%= t('auth.loginBtn') %></button>
    </form>
    <p class="muted small"><%= t('auth.demoHint') %></p>
    <p class="muted"><%= t('auth.noAccount') %> <a href="/register"><%= t('nav.register') %></a></p>
  </div>
</main>
<%- include('partials/footer') %>
